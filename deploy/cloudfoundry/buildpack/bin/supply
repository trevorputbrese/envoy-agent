#!/usr/bin/env bash
# supply BUILD_DIR CACHE_DIR DEPS_DIR INDEX
#
# Stages Envoy's pinned toolchain (Python, uv, Node, ripgrep from pm/lock.json, every artifact
# sha256-checked) into the dependency directory and builds the Python environment from uv.lock.
set -euo pipefail

build_dir="$1" cache_dir="$2" deps_dir="$3" index="$4"
bp_dir="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$bp_dir/lib/common.sh"

deps="$deps_dir/$index"
store="$deps/tools"
mkdir -p "$store" "$deps/bin" "$build_dir/.profile.d" "$cache_dir"

step "Envoy buildpack $(cat "$bp_dir/VERSION") ($ENVOY_TARGET)"

# Staging-only state: pm's receipts and caches live in the cache dir so a re-push reuses them.
export HERMES_HOME="$cache_dir/staging-home"
export HERMES_RUNTIME_DIR="$store"
export UV_CACHE_DIR="$cache_dir/uv"
export UV_PYTHON_INSTALL_DIR="$cache_dir/uv-python"
export UV_NO_CONFIG=1
export PYTHONDONTWRITEBYTECODE=1
mkdir -p "$HERMES_HOME"

step "Staging pinned uv"
uv="$(stage_uv "$build_dir/pm/lock.json" "$store")"
info "$("$uv" --version)"

step "Bootstrapping Python"
py_minor="$(pin version python "$build_dir/pm/lock.json" | cut -d+ -f1 | cut -d. -f1,2)"
"$uv" python install --no-bin --no-registry "$py_minor" >/dev/null
boot_py="$("$uv" python find --managed-python "$py_minor")"
info "bootstrap $("$boot_py" --version)"

step "Installing the pinned runtime (python, node, npm, ripgrep, ffmpeg) through pm"
tools="${ENVOY_BUILDPACK_TOOLS:-python uv node npm ripgrep ffmpeg}"
# Run pm from a tree holding only pm itself (as the image build does): from the checkout it would
# also sync a project venv, which the explicit build below owns.
pm_root="$(mktemp -d)"
mkdir -p "$pm_root/hermes_cli" "$pm_root/scripts/bundles"
cp -R "$build_dir/pm" "$pm_root/pm"
cp "$build_dir/hermes_constants.py" "$pm_root/"
cp "$build_dir/hermes_cli/__init__.py" "$build_dir/hermes_cli/runtime_state.py" "$pm_root/hermes_cli/"
cp "$build_dir/scripts/bundles/payload.py" "$pm_root/scripts/bundles/"
(cd "$pm_root" && "$boot_py" -c '
import sys
from pm import ensure, installed_package
for name in sys.argv[1:]:
    ensure(name, explicit=True)
for name in ("python", "node"):
    print(f"{name}={installed_package(name).binary}")
' $tools) > "$deps/tool-paths.env"
rm -rf "$pm_root"
python="$(sed -n 's/^python=//p' "$deps/tool-paths.env")"
node="$(sed -n 's/^node=//p' "$deps/tool-paths.env")"
[ -x "$python" ] || fail "pm did not stage a Python interpreter"
info "runtime $("$python" --version), node $("$node" --version)"

step "Building the Python environment from uv.lock"
extras="${ENVOY_BUILDPACK_EXTRAS:-web mcp ddgs pty cron}"
extra_args=()
for extra in $extras; do extra_args+=(--extra "$extra"); done
if [ -e "$build_dir/.venv" ]; then
  info "dropping a pushed .venv (add it to .cfignore): $(ls "$build_dir/.venv" | tr '\n' ' ')"
  rm -rf "$build_dir/.venv"
fi
venv="$deps/venv"
(cd "$build_dir" && "$python" -m pm.build_env --source "$build_dir" --python "$python" \
  --cache "$cache_dir/uv-cache" --out "$venv" --no-install-project \
  "${extra_args[@]}")
info "extras: $extras"

# Every path above was recorded under the staging directories (under /tmp). The droplet
# runs from /home/vcap, so the profile script points the staging paths back at the droplet before
# anything starts; nothing has to be rewritten.
cat > "$build_dir/.profile.d/00-envoy.sh" <<EOF
# Generated by the Envoy buildpack.
for link in "$build_dir=\$HOME" "$deps_dir=\$DEPS_DIR"; do
  staged="\${link%%=*}" live="\${link#*=}"
  [ -e "\$staged" ] || [ "\$staged" = "\$live" ] || { mkdir -p "\$(dirname "\$staged")" && ln -s "\$live" "\$staged"; }
done
export HERMES_RUNTIME_DIR="$store"
export HERMES_PYTHON="$venv/bin/python"
export PYTHONPATH="$build_dir\${PYTHONPATH:+:\$PYTHONPATH}"
export PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
export PATH="$deps/bin:$venv/bin:$(dirname "$node"):\$PATH"
export HERMES_HOME="\${HERMES_HOME:-\$HOME/.envoy-home}"
export HERMES_WEB_DIST="\${HERMES_WEB_DIST:-$build_dir/hermes_cli/web_dist}"
if [ -f "$build_dir/.envoy-cf/tui/dist/entry.js" ]; then export HERMES_TUI_DIR="\${HERMES_TUI_DIR:-$build_dir/.envoy-cf/tui}"; fi
EOF

mkdir -p "$build_dir/.envoy-cf/lib"
cp "$bp_dir/lib/vcap_config.py" "$bp_dir/lib/start.sh" "$build_dir/.envoy-cf/lib/"
cat > "$deps/bin/envoy" <<EOF
#!/usr/bin/env bash
exec "$venv/bin/python" -m hermes_cli.main "\$@"
EOF
ln -sf envoy "$deps/bin/hermes"  # upstream code paths still look the CLI up by its old name
chmod 0755 "$deps/bin/envoy" "$build_dir/.envoy-cf/lib/start.sh"
step "Envoy runtime ready"
